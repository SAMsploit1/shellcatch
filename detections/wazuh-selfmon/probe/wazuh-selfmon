#!/usr/bin/env python3
"""wazuh-selfmon: a self-monitoring probe for a Wazuh 4.x manager + indexer host.

Runs from its own systemd timer, outside wazuh-manager's process tree, so it
keeps working when the manager is the thing that died. Each run:

  * checks the manager's daemons by process (not by unit state), wazuh-db
    memory, analysisd/remoted drop counters, UDP receive-buffer errors, local
    disk, the indexer's health, disk watermarks, write blocks and ISM failures;
  * writes one JSON line per finding to a log file that the manager's own
    logcollector reads (rules 100800-100819 turn them into alerts);
  * emits a "canary" record every run and, on the next run, checks the canary
    actually reached the indexer, so a stall anywhere in
    logcollector -> analysisd -> alerts.json -> filebeat -> indexer is caught
    and the broken stage named;
  * sends CRITICAL findings out-of-band (webhook) because if Wazuh is down,
    an alert raised through Wazuh goes nowhere;
  * optionally repairs a manager whose unit is "active" but whose daemons are
    missing, rate-limited so it cannot become a restart loop.

Standard library only. Configuration: /etc/wazuh-selfmon.conf (KEY=VALUE).
"""

import argparse
import json
import os
import shutil
import socket
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid

